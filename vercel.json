{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/checkout.ts": { "maxDuration": 60 },
    "api/donations.ts": { "maxDuration": 60 },
    "api/supporter.ts": { "maxDuration": 60 }
  },
  "redirects": [
    {
      "source": "/:alias(projetos|projeto|detalhes-projeto)",
      "has": [{"type": "query", "key": "id", "value": "(?<projectId>[a-z0-9-]+)"}],
      "destination": "/projetos/:projectId",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/portal-do-apoiador",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]
    },
    {
      "source": "/gestao/doacoes",
      "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow"}]
    },
    {
      "source": "/documentos/estatuto-social-instituto-caminho-e-forma.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"estatuto-social-instituto-caminho-e-forma.pdf\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
